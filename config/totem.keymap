/*
 * TOTEM keymap  --  Cornix migration
 *
 * Layers : Base(0) / Num(1) / Fn(2) / Mac(3) / MacFn(4)
 *
 *  Thumbs   : Esc(hold Fn)  Space  Ctrl  |  Bksp  Enter  Tab(hold Num)
 *  GUI      : J + K combo (sticky)
 *  Shift    : both pinky keys (tap Shift / double-tap Caps or ')
 *  Han/Eng  : hold left Shift + Space   (OS handles it, Win & Mac same)
 *
 *  Mac mode : toggle by pressing BOTH pinky keys together.
 *             - thumb Ctrl  becomes Cmd
 *             - Quit / Screenshot keys auto-switch to the macOS combo
 *               (handled by the hidden MacFn layer, so normal typing
 *                is never affected)
 *
 *  Quit key : Fn layer -> Win = Alt+F4 / Mac = Cmd+Q   (same key)
 *  Shot key : Fn layer -> Win = Win+Shift+S / Mac = Cmd+Shift+4
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>

#define BASE  0
#define NUM   1
#define FN    2
#define MAC   3
#define MACFN 4


&lt {
    tapping-term-ms = <240>;
    flavor = "balanced";
    quick-tap-ms = <150>;
    require-prior-idle-ms = <150>;
};


/ {
    macros {
        m_selline: m_selline {          /* select current line */
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END)>;
        };
    };

    behaviors {
        td_shft: td_shft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp LSHFT>, <&kp CAPS>;
        };

        td_rshft: td_rshft {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RSHFT>, <&kp SQT>;
        };
    };

    combos {
        compatible = "zmk,combos";

        combo_gui {
            timeout-ms = <40>;
            require-prior-idle-ms = <100>;
            key-positions = <16 17>;     /* J + K  -> sticky GUI */
            bindings = <&sk LGUI>;
        };

        combo_macmode {
            timeout-ms = <50>;
            require-prior-idle-ms = <200>;
            key-positions = <20 31>;     /* both pinky keys -> toggle Mac */
            bindings = <&tog MAC>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        mac_fn {
            if-layers = <FN MAC>;
            then-layer = <MACFN>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
                &kp Q       &kp W   &kp E   &kp R   &kp T          &kp Y      &kp U      &kp I       &kp O     &kp P
                &kp A       &kp S   &kp D   &kp F   &kp G          &kp H      &kp J      &kp K       &kp L     &kp SEMI
&td_shft        &kp Z       &kp X   &kp C   &kp V   &kp B          &kp N      &kp M      &kp COMMA   &kp DOT   &kp FSLH   &td_rshft
                                    &lt FN ESC  &kp SPACE  &kp LCTRL    &kp BSPC   &kp RET    &lt NUM TAB
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
                &kp N1      &kp N2  &kp N3  &kp N4  &kp N5         &kp HOME   &kp PG_UP  &kp PG_DN   &kp END   &trans
                &kp N6      &kp N7  &kp N8  &kp N9  &kp N0         &kp LEFT   &kp DOWN   &kp UP      &kp RIGHT &trans
&trans          &trans      &trans  &trans  &trans  &kp DOT        &kp PLUS   &kp MINUS  &kp ASTRK   &kp FSLH  &kp EQUAL  &trans
                                    &trans      &trans     &trans       &trans     &trans     &trans
            >;
        };

        Fn {
            display-name = "Fn";
            bindings = <
                &kp F1      &kp F2  &kp F3  &kp F4  &kp F5         &trans       &trans      &trans         &trans       &trans
                &kp F6      &kp F7  &kp F8  &kp F9  &kp F10        &kp LA(F4)   &m_selline  &kp LG(LS(S))  &bootloader  &trans
&trans          &kp F11     &kp F12 &trans  &trans  &trans         &trans       &trans      &trans         &trans       &trans     &trans
                                    &trans      &trans     &trans       &trans     &trans     &trans
            >;
        };

        Mac {
            display-name = "Mac";
            bindings = <
                &trans      &trans  &trans  &trans  &trans         &trans     &trans     &trans      &trans    &trans
                &trans      &trans  &trans  &trans  &trans         &trans     &trans     &trans      &trans    &trans
&trans          &trans      &trans  &trans  &trans  &trans         &trans     &trans     &trans      &trans    &trans     &trans
                                    &trans      &trans     &kp LGUI     &trans     &trans     &trans
            >;
        };

        MacFn {
            display-name = "MacFn";
            bindings = <
                &trans      &trans  &trans  &trans  &trans         &trans       &trans     &trans            &trans    &trans
                &trans      &trans  &trans  &trans  &trans         &kp LG(Q)    &trans     &kp LG(LS(N4))    &trans    &trans
&trans          &trans      &trans  &trans  &trans  &trans         &trans       &trans     &trans            &trans    &trans     &trans
                                    &trans      &trans     &trans       &trans     &trans     &trans
            >;
        };
    };
};
