{
  "version": 1,
  "notes": "TOTEM keymap ported to Corone 46\n\nTotem 38-key layout mapped to Corone 46:\n  Extra keys (outer col R0/R1, inner col R0/R1) = KC_TRNS\n  Core 5-col grid + thumbs = identical to TOTEM\n\nKey positions:\n  L-R0: outer(0)[TRNS] Q(1) W(2) E(3) R(4) T(5) inner(6)[TRNS]\n  L-R1: outer(7)[TRNS] A(8) S(9) D(10) F(11) G(12) inner(13)[TRNS]\n  L-R2: TD0(14) Z(15) X(16) C(17) V(18) B(19)\n  L-Thumb: ESC/Fn(20) SPC(21) CTRL(22)\n  R-R0: inner(23)[TRNS] Y(24) U(25) I(26) O(27) P(28) outer(29)[TRNS]\n  R-R1: inner(30)[TRNS] H(31) J(32) K(33) L(34) ;(35) outer(36)[TRNS]\n  R-R2: N(37) M(38) ,(39) .(40) /(41) TD1(42)\n  R-Thumb: BSPC(43) ENT(44) TAB/Num(45)\n\nLayers: 0=Base 1=Num 2=Fn 3=Mac 4=MacFn\n\nTap Dance (Vial GUI > Tap Dance):\n  TD(0): tap=LShift double=CapsLock\n  TD(1): tap=RShift double=Quote\n\nCombos (Vial GUI > Combos):\n  J+K          -> OSM(MOD_LGUI)  one-shot Win/Cmd\n  D+F          -> OSM(MOD_LALT)  one-shot Alt/Option\n  TD(0)+TD(1)  -> TG(3)          Mac mode toggle (both pinkies)\n\nMacro 0 (Vial GUI > Macros): Home + Shift+End (select line)",
  "documentation": "TOTEM keymap ported to Corone 46. Extra outer/inner column keys are transparent.",
  "keyboard": "corone",
  "keymap": [
    [
      "KC_TRNS",      "KC_Q",    "KC_W",    "KC_E",    "KC_R",    "KC_T",    "KC_TRNS",
      "KC_TRNS",      "KC_A",    "KC_S",    "KC_D",    "KC_F",    "KC_G",    "KC_TRNS",
      "TD(0)",         "KC_Z",    "KC_X",    "KC_C",    "KC_V",    "KC_B",
      "LT(2,KC_ESC)", "KC_SPC",  "KC_LCTL",
      "KC_TRNS",      "KC_Y",    "KC_U",    "KC_I",    "KC_O",    "KC_P",    "KC_TRNS",
      "KC_TRNS",      "KC_H",    "KC_J",    "KC_K",    "KC_L",    "KC_SCLN", "KC_TRNS",
      "KC_N",         "KC_M",    "KC_COMM", "KC_DOT",  "KC_SLSH", "TD(1)",
      "KC_BSPC",      "KC_ENT",  "LT(1,KC_TAB)"
    ],
    [
      "KC_TRNS",  "KC_1",    "KC_2",    "KC_3",    "KC_4",    "KC_5",    "KC_TRNS",
      "KC_TRNS",  "KC_6",    "KC_7",    "KC_8",    "KC_9",    "KC_0",    "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_DOT",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_HOME", "KC_PGUP", "KC_PGDN", "KC_END",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_LEFT", "KC_DOWN", "KC_UP",   "KC_RGHT", "KC_TRNS", "KC_TRNS",
      "KC_PLUS",  "KC_MINS", "KC_ASTR", "KC_SLSH", "KC_EQL",  "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS"
