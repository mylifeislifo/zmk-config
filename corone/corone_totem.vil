{
  "version": 1,
  "notes": "TOTEM keymap ported to Corone 46\n\nTotem 38-key layout mapped to Corone 46:\n  Extra keys (outer col R0/R1, inner col R0/R1) = KC_TRNS\n  Core 5-col grid + thumbs = identical to TOTEM\n\nLayers: 0=Base 1=Num 2=Fn 3=Mac 4=MacFn\n\nTap Dance (Vial GUI > Tap Dance):\n  TD(0): tap=LShift double=CapsLock\n  TD(1): tap=RShift double=Quote\n\nCombos (Vial GUI > Combos):\n  J+K -> KC_LGUI  (Win/Cmd key)\n  D+F -> KC_LALT  (Alt/Option key)\n\nMacro 0 (Vial GUI > Macros): Home + Shift+End (select line)",
  "documentation": "TOTEM keymap ported to Corone 46.",
  "keyboard": "corone",
  "layout": [
    [
      "KC_TRNS",      "KC_Q",    "KC_W",    "KC_E",    "KC_R",    "KC_T",    "KC_TRNS",
      "KC_TRNS",      "KC_A",    "KC_S",    "KC_D",    "KC_F",    "KC_G",    "KC_TRNS",
      "TD(0)",         "KC_Z",    "KC_X",    "KC_C",    "KC_V",    "KC_B",
      "LT(2,KC_ESC)", "KC_SPC",  "KC_LCTL",
      "KC_TRNS",      "KC_Y",    "KC_U",    "KC_I",    "KC_O",    "KC_P",    "KC_TRNS",
      "KC_TRNS",      "KC_H",    "KC_J",    "KC_K",    "KC_L",    "KC_SCLN", "KC_TRNS",
      "KC_N",         "KC_M",    "KC_COMM", "KC_DOT",  "KC_SLSH", "TD(1)",
      "KC_BSPC",      "KC_ENT",  "LT(1,KC_TAB)"
    ],
    [
      "KC_TRNS",  "KC_1",    "KC_2",    "KC_3",    "KC_4",    "KC_5",    "KC_TRNS",
      "KC_TRNS",  "KC_6",    "KC_7",    "KC_8",    "KC_9",    "KC_0",    "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_DOT",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_HOME", "KC_PGUP", "KC_PGDN", "KC_END",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_LEFT", "KC_DOWN", "KC_UP",   "KC_RGHT", "KC_TRNS", "KC_TRNS",
      "KC_PLUS",  "KC_MINS", "KC_ASTR", "KC_SLSH", "KC_EQL",  "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS"
    ],
    [
      "KC_TRNS",  "KC_F1",   "KC_F2",   "KC_F3",   "KC_F4",   "KC_F5",   "KC_TRNS",
      "KC_TRNS",  "KC_F6",   "KC_F7",   "KC_F8",   "KC_F9",   "KC_F10",  "KC_TRNS",
      "KC_TRNS",  "KC_F11",  "KC_F12",  "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",       "KC_TRNS",          "KC_TRNS",          "KC_TRNS",           "KC_TRNS",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",       "LALT(KC_F4)",       "QK_MACRO_0",       "KC_TRNS",           "QK_BOOT",  "KC_TRNS", "KC_TRNS",
      "LGUI(KC_LEFT)", "LGUI(KC_DOWN)",     "LGUI(KC_UP)",      "LGUI(KC_RGHT)",     "KC_TRNS",  "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS"
    ],
    [
      "KC_TRNS",       "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",       "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",       "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "LT(4,KC_ESC)",  "KC_TRNS", "KC_LGUI",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS"
    ],
    [
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",            "KC_TRNS",            "KC_TRNS",           "KC_TRNS",            "KC_TRNS",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "LGUI(KC_Q)", "KC_TRNS",  "KC_TRNS",  "KC_TRNS",  "KC_TRNS", "KC_TRNS",
      "KC_TRNS",  "KC_TRNS",   "KC_TRNS",  "KC_TRNS",  "KC_TRNS",  "KC_TRNS",
      "KC_TRNS",  "KC_TRNS", "KC_TRNS"
    ]
  ],
  "tap_dance": [
    {"tap": "KC_LSFT", "hold": "KC_NO", "double_tap": "KC_CAPS", "tap_hold": "KC_NO", "tapping_term": 200},
    {"tap": "KC_RSFT", "hold": "KC_NO", "double_tap": "KC_QUOT", "tap_hold": "KC_NO", "tapping_term": 200}
  ],
  "combo": [
    {"key1": "KC_J", "key2": "KC_K", "output": "KC_LGUI", "term": 40},
    {"key1": "KC_D", "key2": "KC_F", "output": "KC_LALT", "term": 40}
  ],
  "macro": [
    [
      {"action": "tap",  "keycodes": ["KC_HOME"]},
      {"action": "down", "keycodes": ["KC_LSFT"]},
      {"action": "tap",  "keycodes": ["KC_END"]},
      {"action": "up",   "keycodes": ["KC_LSFT"]}
    ]
  ]
}
